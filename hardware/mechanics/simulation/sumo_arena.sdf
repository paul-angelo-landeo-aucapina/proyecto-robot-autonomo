<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sumo_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Scene lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15 15</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15 15</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sumo Dohyo / Arena Ring (R = 1.0 m, Dark Tatami with White Border) -->
    <model name="dohyo_mat">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="mat_link">
        <visual name="mat_surface">
          <geometry>
            <cylinder>
              <radius>1.10</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="border_ring">
          <geometry>
            <cylinder>
              <radius>1.15</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dynamic Obstacle 1: Canister / Cylinder (1.2 kg) -->
    <model name="obstaculo_cilindro">
      <pose>0.70 0.35 0.10 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.20</mass>
          <inertia>
            <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.003</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.5 0.1 1</ambient>
            <diffuse>0.95 0.55 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dynamic Obstacle 2: Heavy Cube (1.8 kg) -->
    <model name="obstaculo_cubo">
      <pose>0.50 -0.45 0.08 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.80</mass>
          <inertia>
            <ixx>0.007</ixx><iyy>0.007</iyy><izz>0.007</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry>
            <box>
              <size>0.16 0.16 0.16</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.16 0.16 0.16</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.8 1</ambient>
            <diffuse>0.2 0.5 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static Boundary Wall (Soft containment ring R = 2.0 m) -->
    <model name="arena_wall_north">
      <static>true</static>
      <pose>0 1.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.8 0.1 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.8 0.1 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 0.8</ambient><diffuse>0.4 0.4 0.4 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="arena_wall_south">
      <static>true</static>
      <pose>0 -1.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.8 0.1 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.8 0.1 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 0.8</ambient><diffuse>0.4 0.4 0.4 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="arena_wall_east">
      <static>true</static>
      <pose>1.8 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 3.6 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 3.6 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 0.8</ambient><diffuse>0.4 0.4 0.4 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="arena_wall_west">
      <static>true</static>
      <pose>-1.8 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 3.6 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 3.6 0.3</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 0.8</ambient><diffuse>0.4 0.4 0.4 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Include Robot Sumoso -->
    <include>
      <name>robot_sumoso</name>
      <uri>/home/paul/Documents/workfiles/RobotSumoso/robot_sumoso.sdf</uri>
      <pose>0 0 0.0325 0 0 0</pose>
    </include>

  </world>
</sdf>
