<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="robot_sumoso">
    <static>false</static>
    <pose>0 0 0.040 0 0 0</pose>


    <!-- Base Link (Chassis, Electronics, Battery, Load Cell Bridge) -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.020 0 0.020 0 0 0</pose>
        <mass>2.60</mass>
        <inertia>
          <ixx>0.02089</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.03605</iyy>
          <iyz>0</iyz>
          <izz>0.05417</izz>
        </inertia>
      </inertial>

      <!-- Visual: Main Base Plate (Ground Clearance = 10.0 mm) -->
      <visual name="base_plate_visual">
        <pose>0 0 -0.027 0 0 0</pose>
        <geometry>
          <box>
            <size>0.400 0.300 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.3 0.4 0.8</ambient>
          <diffuse>0.3 0.4 0.6 0.8</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>

      <!-- Collision: Main Base Plate (Leaves 10mm free clearance to floor) -->
      <collision name="base_plate_collision">
        <pose>0 0 -0.027 0 0 0</pose>
        <geometry>
          <box>
            <size>0.390 0.290 0.006</size>
          </box>
        </geometry>
      </collision>

      <!-- Visual: Aluminum Rails 6061-T6 (Left & Right) -->
      <visual name="rail_left_visual">
        <pose>0 0.105 -0.0165 0 0 0</pose>
        <geometry>
          <box>
            <size>0.320 0.015 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
        </material>
      </visual>
      <visual name="rail_right_visual">
        <pose>0 -0.105 -0.0165 0 0 0</pose>
        <geometry>
          <box>
            <size>0.320 0.015 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- Visual: Battery Pack (CoM centered) -->
      <visual name="battery_visual">
        <pose>0.020 0 0.020 0 0 0</pose>
        <geometry>
          <box>
            <size>0.140 0.050 0.040</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.1 1.0</ambient>
          <diffuse>0.2 0.7 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Visual: Load Cell Bridge & Transducer -->
      <visual name="load_cell_bridge_visual">
        <pose>0.020 0 0.040 0 0 0</pose>
        <geometry>
          <box>
            <size>0.130 0.035 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.5 0.1 1.0</ambient>
          <diffuse>0.9 0.6 0.2 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Structural Enclosure & Bodywork Link (Faldón Base + Tapa Desmontable) -->
    <link name="carcass_link">
      <pose>0 0 0.026 0 0 0</pose>
      <inertial>
        <pose>0 0 0.010 0 0 0</pose>
        <mass>0.818</mass>
        <inertia>
          <ixx>0.00708</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01185</iyy>
          <iyz>0</iyz>
          <izz>0.01704</izz>
        </inertia>
      </inertial>

      <!-- Visual: Lower Perimeter Skirt (Faldón Base) -->
      <visual name="carcass_skirt_visual">
        <pose>-0.200 -0.150 -0.066 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>carcasa_faldon_base.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.28 0.32 0.95</ambient>
          <diffuse>0.30 0.34 0.38 0.95</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- Visual: Removable Hood (Tapa Enteriza Desmontable) -->
      <visual name="carcass_hood_visual">
        <pose>-0.200 -0.150 -0.066 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>carcasa_tapa_superior.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.30 0.35 0.42 0.95</ambient>
          <diffuse>0.35 0.42 0.50 0.95</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>

      <!-- Collision: Perimeter Shell Walls (Convex Box Approximations) -->
      <!-- Left Wall -->
      <collision name="carcass_wall_left">
        <pose>0 0.148 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.396 0.004 0.116</size>
          </box>
        </geometry>
      </collision>
      <!-- Right Wall -->
      <collision name="carcass_wall_right">
        <pose>0 -0.148 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.396 0.004 0.116</size>
          </box>
        </geometry>
      </collision>
      <!-- Front Wall -->
      <collision name="carcass_wall_front">
        <pose>0.198 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.004 0.296 0.116</size>
          </box>
        </geometry>
      </collision>
      <!-- Rear Wall -->
      <collision name="carcass_wall_rear">
        <pose>-0.198 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.004 0.296 0.116</size>
          </box>
        </geometry>
      </collision>
      <!-- Top Ceiling (excluding weighing tray aperture) -->
      <collision name="carcass_ceiling_front">
        <pose>0.162 0 0.058 0 0 0</pose>
        <geometry>
          <box>
            <size>0.076 0.296 0.004</size>
          </box>
        </geometry>
      </collision>
      <collision name="carcass_ceiling_rear">
        <pose>-0.142 0 0.058 0 0 0</pose>
        <geometry>
          <box>
            <size>0.116 0.296 0.004</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Rigid Mounting Joint from Base to Carcass -->
    <joint name="carcass_joint" type="fixed">
      <parent>base_link</parent>
      <child>carcass_link</child>
    </joint>


    <!-- Floating Weighing Tray Link -->
    <link name="weighing_tray">
      <pose>0.020 0 0.065 0 0 0</pose>
      <inertial>
        <mass>0.40</mass>
        <inertia>
          <ixx>0.00133</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00133</iyy>
          <iyz>0</iyz>
          <izz>0.00266</izz>
        </inertia>
      </inertial>
      <visual name="tray_visual">
        <geometry>
          <box>
            <size>0.200 0.200 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 0.9</ambient>
          <diffuse>0.9 0.9 0.3 0.9</diffuse>
        </material>
      </visual>
      <collision name="tray_collision">
        <geometry>
          <box>
            <size>0.200 0.200 0.004</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Load Cell Prismatic Joint (Z measurement axis) -->
    <joint name="load_cell_joint" type="prismatic">
      <parent>base_link</parent>
      <child>weighing_tray</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.005</lower>
          <upper>0.005</upper>
          <effort>100</effort>
        </limit>
        <dynamics>
          <spring_stiffness>50000</spring_stiffness>
          <damping>150</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- REAR LEFT DRIVE WHEEL (37D Motor) -->
    <link name="left_wheel">
      <pose>-0.130 0.130 0 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>4.5e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.5e-5</iyy>
          <iyz>0</iyz>
          <izz>4.5e-5</izz>
        </inertia>
      </inertial>
      <visual name="left_wheel_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>1.08</effort>
        </limit>
      </axis>
    </joint>

    <!-- REAR RIGHT DRIVE WHEEL (37D Motor) -->
    <link name="right_wheel">
      <pose>-0.130 -0.130 0 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>4.5e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.5e-5</iyy>
          <iyz>0</iyz>
          <izz>4.5e-5</izz>
        </inertia>
      </inertial>
      <visual name="right_wheel_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <collision name="right_wheel_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>1.08</effort>
        </limit>
      </axis>
    </joint>

    <!-- FRONT LEFT OMNIWHEEL (80mm) -->
    <link name="front_left_omni">
      <pose>0.130 0.130 0 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>3.2e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.5e-5</iyy>
          <iyz>0</iyz>
          <izz>3.2e-5</izz>
        </inertia>
      </inertial>
      <visual name="front_left_omni_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.2 1.0</ambient>
          <diffuse>0.3 0.6 0.3 1.0</diffuse>
        </material>
      </visual>
      <collision name="front_left_omni_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.040</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.02</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_omni_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_omni</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- FRONT RIGHT OMNIWHEEL (80mm) -->
    <link name="front_right_omni">
      <pose>0.130 -0.130 0 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>3.2e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.5e-5</iyy>
          <iyz>0</iyz>
          <izz>3.2e-5</izz>
        </inertia>
      </inertial>
      <visual name="front_right_omni_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.028</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.2 1.0</ambient>
          <diffuse>0.3 0.6 0.3 1.0</diffuse>
        </material>
      </visual>
      <collision name="front_right_omni_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.040</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.02</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_right_omni_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_omni</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- GAZEBO PLUGINS -->
    <!-- 1. Differential Drive System -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.260</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_linear_velocity>-0.8</min_linear_velocity>
      <max_linear_velocity>0.8</max_linear_velocity>
      <min_angular_velocity>-3.14</min_angular_velocity>
      <max_angular_velocity>3.14</max_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odometry</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- 2. Joint State Publisher -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

  </model>
</sdf>
