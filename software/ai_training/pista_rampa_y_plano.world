<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pista_rampa_y_piso_plano">

    <!-- ================================================================= -->
    <!-- 1. CONDICIONES DE ILUMINACION Y FISICA ODE                         -->
    <!-- ================================================================= -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================================================================= -->
    <!-- 2. PISO PLANO INICIAL (ZONA DE ARRANQUE Y NAVEGACION PUNTO A)      -->
    <!-- ================================================================= -->
    <!-- Marcador de inicio Punto A (0, 0, 0) -->
    <model name="marcador_punto_a">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0 0.8 0.2 1</ambient><diffuse>0 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo reactivo 1 en piso plano (Fuerza desvio frontal ToF < 180 mm) -->
    <model name="obstaculo_plano_1">
      <static>true</static>
      <pose>1.0 0.08 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.10</radius><length>0.30</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.10</radius><length>0.30</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo de emergencia 2 en piso plano (Para probar Active Braking < 80 mm) -->
    <model name="barrera_emergencia_plano">
      <static>true</static>
      <pose>1.6 -0.35 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.12 0.35 0.30</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.12 0.35 0.30</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 3. RAMPA DE SUBIDA (INCLINE RAMP: de X=2.0 a X=4.0, sube a Z=0.45m)-->
    <!-- Inclinacion de aprox. 12.7 grados (0.222 rad)                     -->
    <!-- ================================================================= -->
    <model name="rampa_subida">
      <static>true</static>
      <!-- Centro de la rampa en X=3.0, Z=0.225, pitch = -0.222 rad -->
      <pose>3.0 0 0.225 0 -0.222 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2.05 1.40 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>2.05 1.40 0.05</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Barandas de seguridad laterales rampa subida -->
    <model name="baranda_subida_izq">
      <static>true</static>
      <pose>3.0 0.72 0.35 0 -0.222 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2.05 0.04 0.25</size></box></geometry></collision><visual name="v"><geometry><box><size>2.05 0.04 0.25</size></box></geometry><material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="baranda_subida_der">
      <static>true</static>
      <pose>3.0 -0.72 0.35 0 -0.222 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2.05 0.04 0.25</size></box></geometry></collision><visual name="v"><geometry><box><size>2.05 0.04 0.25</size></box></geometry><material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material></visual></link>
    </model>

    <!-- ================================================================= -->
    <!-- 4. MESETA SUPERIOR (PLATAFORMA ELEVADA: X=4.0 a X=5.2, Z=0.45m)    -->
    <!-- ================================================================= -->
    <model name="plataforma_superior">
      <static>true</static>
      <pose>4.6 0 0.425 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.20 1.40 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.20 1.40 0.05</size></box></geometry>
          <material><ambient>0.3 0.35 0.5 1</ambient><diffuse>0.3 0.35 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo en la meseta superior (Prueba evasion en altura) -->
    <model name="obstaculo_meseta">
      <static>true</static>
      <pose>4.6 -0.15 0.575 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.10</radius><length>0.25</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.10</radius><length>0.25</length></cylinder></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- 5. RAMPA DE BAJADA (DECLINE RAMP: de X=5.2 a X=7.2, baja a Z=0.0m) -->
    <!-- Inclinacion de aprox. 12.7 grados (+0.222 rad)                     -->
    <!-- ================================================================= -->
    <model name="rampa_bajada">
      <static>true</static>
      <!-- Centro en X=6.2, Z=0.225, pitch = +0.222 rad -->
      <pose>6.2 0 0.225 0 0.222 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>2.05 1.40 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>2.05 1.40 0.05</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Barandas de seguridad laterales rampa bajada -->
    <model name="baranda_bajada_izq">
      <static>true</static>
      <pose>6.2 0.72 0.35 0 0.222 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2.05 0.04 0.25</size></box></geometry></collision><visual name="v"><geometry><box><size>2.05 0.04 0.25</size></box></geometry><material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="baranda_bajada_der">
      <static>true</static>
      <pose>6.2 -0.72 0.35 0 0.222 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2.05 0.04 0.25</size></box></geometry></collision><visual name="v"><geometry><box><size>2.05 0.04 0.25</size></box></geometry><material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material></visual></link>
    </model>

    <!-- ================================================================= -->
    <!-- 6. PISO PLANO FINAL Y META OBJETIVO (PUNTO B: X=8.2, Y=0.0)        -->
    <!-- ================================================================= -->
    <!-- Marcador visual del Punto Objetivo B -->
    <model name="marcador_punto_b">
      <static>true</static>
      <pose>8.2 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.30</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstaculo de aproximacion final -->
    <model name="obstaculo_final">
      <static>true</static>
      <pose>7.6 0.2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 0.25 0.30</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 0.25 0.30</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Paredes perimetrales de contencion general -->
    <model name="pared_final_tope">
      <static>true</static>
      <pose>9.2 0 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 3.0 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 3.0 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
    </model>
    <model name="pared_inicio_tope">
      <static>true</static>
      <pose>-1.0 0 0.25 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.1 3.0 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.1 3.0 0.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
