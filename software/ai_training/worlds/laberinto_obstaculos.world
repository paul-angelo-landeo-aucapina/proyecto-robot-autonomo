<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="mundo_evaluacion_robot">
    
    <!-- Propiedades del motor de física -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins esenciales del sistema Gazebo Harmonic -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Iluminación direccional (Sol) nativa sin dependencias externas -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Plano de suelo nativo -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes del recinto cerrado (Recinto 4m x 4m) -->
    <model name="pared_norte">
      <static>true</static>
      <pose>0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="pared_sur">
      <static>true</static>
      <pose>0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 0.1 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.2 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="pared_este">
      <static>true</static>
      <pose>2.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="pared_oeste">
      <static>true</static>
      <pose>-2.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 4.0 0.5</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstaculo frontal 1 (Para probar frenado a 180 mm y giro) -->
    <model name="bloque_frontal_1">
      <static>true</static>
      <pose>0.8 0.1 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.4</size></box></geometry></visual>
      </link>
    </model>

    <!-- Obstaculo 2 (Para probar emergencia < 80 mm en curva) -->
    <model name="bloque_lateral_2">
      <static>true</static>
      <pose>0.8 -0.8 0.2 0 0 0.785</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
